# All settings are optional; the defaults work for local use.

# DJANGO_SECRET_KEY=change-me
# DJANGO_DEBUG=true
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Use PostgreSQL instead of SQLite (also needs: pip install "psycopg[binary]")
# DATABASE_URL=postgres://user:password@localhost:5432/fuel_routes

# Use Redis for the cache instead of in-process memory (also needs: pip install redis)
# REDIS_URL=redis://localhost:6379/0

# Any OSRM-compatible routing server
# OSRM_BASE_URL=https://router.project-osrm.org
# OSRM_TIMEOUT_SECONDS=15

# Dollar cost the optimizer assigns to each fuel stop
# DEFAULT_STOP_PENALTY=5
